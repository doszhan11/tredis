# Paste into Railway → service → Variables. Never commit real values.

# Telegram token of @genesis_sweep_bot (from @BotFather)
BOT_TOKEN=
# Main admins, comma-separated Telegram ids
OWNER_IDS=
# First admins (used only on the first start)
ADMIN_IDS=
# Folder on the Railway volume for bot data
DATA_DIR=/data
# Public URL of this service on Railway
PUBLIC_BASE_URL=
# Link to the Genesis Sweep indicator on TradingView
INDICATOR_LINK=
# Optional: /webhook/<secret> is also accepted
WEBHOOK_SECRET=
