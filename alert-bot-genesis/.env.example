# Paste into Railway → service → Variables. Never commit real values.

# Telegram token of @tradingkzl_bot (from @BotFather)
BOT_TOKEN=
# Telegram id of the main owner (admin rights)
OWNER_ID=
# Secret part of the TradingView webhook URL: <PUBLIC_BASE_URL>/webhook/<WEBHOOK_SECRET>
WEBHOOK_SECRET=
# Public URL of this service on Railway
PUBLIC_BASE_URL=
# Folder on the Railway volume for users.json, prefs.json, settings.json
DATA_DIR=/data
