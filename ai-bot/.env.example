# Paste into Railway → service → Variables (Raw Editor). Never commit real values.

# Telegram token of the TREDIS AI bot (from @BotFather)
AI_BOT_TOKEN=
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# https://<project-ref>.supabase.co
SUPABASE_URL=
# service_role key (secret, Supabase → Project Settings → API). Not the anon key.
SUPABASE_KEY=
# Comma-separated Telegram ids allowed to run /settier and to get budget alerts
ADMIN_IDS=

# ---- optional
# Shown with the tiers: @username or https:// link
PAYMENT_CONTACT=@tredis_admin
# Admins get one notice per month when BUDGET_ALERT_RATIO of this is spent
MONTHLY_BUDGET_USD=50
BUDGET_ALERT_RATIO=0.8
# Questions, alert explanations, settings parsing
MODEL_CHAT=claude-haiku-5-5
# Pine Script
MODEL_CODE=claude-sonnet-5-5
MAX_TOKENS_CHAT=1500
MAX_TOKENS_CODE=6000
# 1 = test period: hide prices, payment contact and the Pro AI button
TEST_MODE=0
# AI messages a day for users without a valid tier (tier = none). 0 = paid plans only
FREE_MSGS_DAY=3
# Timezone for dates shown to users (limit days follow Postgres current_date, UTC)
TZ_NAME=Asia/Almaty
